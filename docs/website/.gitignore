# v0 runtime files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules/
tsconfig.tsbuildinfo
.next/
.env*.local
.DS_Store
/out

# Next.js generated files (regenerated by next build/dev/typegen)
next-env.d.ts

# fumadocs' generated source index. Regenerated by every `next build` and
# `next dev`, and its import numbering follows directory order — so it changes
# whenever a page is added, without meaning anything. Committing it meant a
# dirty tree after every content change, which the release bump refuses to run
# on.
.source/

# Rendered from ../../plugin/skills by scripts/generate-skill-pages.ts — the
# skill files are the source of truth, and a committed copy would drift.
content/docs/skills/abx-*.mdx
content/docs/skills/meta.json

# Rendered from ../../config/samples by scripts/generate-example-pages.ts, for
# the same reason: the manifests are the source of truth.
content/docs/examples/*/e2b*.mdx
content/docs/examples/*/meta.json

# Build the sandbox (controller / API server) binary.
FROM golang:1.25-alpine AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# Cache Go modules in a separate layer so source edits don't bust the cache.
COPY go.mod go.sum ./
RUN go mod download

# Copy the Go source (relies on .dockerignore to filter).
COPY . .

# CGO disabled + static linking keeps the final image tiny and distroless-friendly.
# TARGETOS / TARGETARCH are set by buildx for multi-arch builds; default to linux
# if running with a plain `docker build`.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o sandbox ./cmd/sandbox

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
WORKDIR /
COPY --from=builder /workspace/sandbox /sandbox
USER 65532:65532

ENTRYPOINT ["/sandbox"]

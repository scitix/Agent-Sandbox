# CI-only: receives pre-built binary from build-binaries job.
# For local full builds use Dockerfile.controller instead.
FROM alpine:3.23
RUN apk add --no-cache ca-certificates
WORKDIR /
ARG TARGETARCH
COPY --chmod=755 installer/dockerfile/bin/sandbox-${TARGETARCH} /sandbox
USER 65532:65532
ENTRYPOINT ["/sandbox"]

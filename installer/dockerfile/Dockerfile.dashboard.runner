# CI-only: receives pre-built Next.js standalone output copied into build/ of the dashboard context.
# For local full builds use Dockerfile.dashboard instead.
FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY build/public ./public
COPY --chown=nextjs:nodejs build/standalone ./
COPY --chown=nextjs:nodejs build/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]

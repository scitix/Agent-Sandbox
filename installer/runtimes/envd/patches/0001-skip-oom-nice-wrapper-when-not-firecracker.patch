diff --git a/packages/envd/internal/services/process/handler/handler_oom_test.go b/packages/envd/internal/services/process/handler/handler_oom_test.go
new file mode 100644
index 000000000..10575507a
--- /dev/null
+++ b/packages/envd/internal/services/process/handler/handler_oom_test.go
@@ -0,0 +1,83 @@
+package handler
+
+import (
+	"context"
+	"os/user"
+	"strings"
+	"testing"
+
+	"github.com/rs/zerolog"
+
+	"github.com/e2b-dev/infra/packages/envd/internal/execcontext"
+	"github.com/e2b-dev/infra/packages/envd/internal/services/cgroups"
+	rpc "github.com/e2b-dev/infra/packages/envd/internal/services/spec/process"
+)
+
+// buildHandler exercises New() up to command construction (no Pty => the
+// process is not started) and returns the assembled *exec.Cmd for inspection.
+func buildHandler(t *testing.T, isNotFC bool) (cmdPath string, cmdArgs []string) {
+	t.Helper()
+
+	u, err := user.Current()
+	if err != nil {
+		t.Fatalf("user.Current: %v", err)
+	}
+
+	cwd := "/tmp"
+	req := &rpc.StartRequest{
+		Process: &rpc.ProcessConfig{
+			Cmd:  "/bin/echo",
+			Args: []string{"hello"},
+			Cwd:  &cwd,
+		},
+	}
+	logger := zerolog.Nop()
+	defaults := &execcontext.Defaults{IsNotFC: isNotFC}
+
+	h, err := New(
+		context.Background(),
+		u,
+		req,
+		&logger,
+		defaults,
+		cgroups.NewNoopManager(),
+		func() {},
+	)
+	if err != nil {
+		t.Fatalf("New(isNotFC=%v): %v", isNotFC, err)
+	}
+	return h.cmd.Path, h.cmd.Args
+}
+
+// In not-FC (Kubernetes) mode the command must be exec'd DIRECTLY: no /bin/sh
+// wrapper and no oom_score_adj write that the kubelet would reject.
+func TestNew_NotFC_ExecsDirectly(t *testing.T) {
+	path, args := buildHandler(t, true)
+
+	if !strings.HasSuffix(path, "/bin/echo") {
+		t.Errorf("expected cmd.Path to be the command itself, got %q", path)
+	}
+	joined := strings.Join(args, " ")
+	if strings.Contains(joined, "/bin/sh") {
+		t.Errorf("not-FC mode must not route through /bin/sh, got args: %v", args)
+	}
+	if strings.Contains(joined, "oom_score_adj") {
+		t.Errorf("not-FC mode must not attempt the oom_score_adj write, got args: %v", args)
+	}
+	if args[0] != "/bin/echo" || args[1] != "hello" {
+		t.Errorf("expected direct [/bin/echo hello], got: %v", args)
+	}
+}
+
+// In FC (microVM) mode the original wrapper is preserved: /bin/sh -c "...".
+func TestNew_FC_KeepsOOMWrapper(t *testing.T) {
+	path, args := buildHandler(t, false)
+
+	if path != "/bin/sh" {
+		t.Errorf("FC mode must wrap in /bin/sh, got cmd.Path=%q", path)
+	}
+	joined := strings.Join(args, " ")
+	if !strings.Contains(joined, "oom_score_adj") {
+		t.Errorf("FC mode must keep the oom_score_adj priming, got args: %v", args)
+	}
+}

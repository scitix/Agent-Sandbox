+
+// rpcPathPrefixes are the Connect service routes gated by -await-init: the ones
+// that run code or touch the filesystem. Everything else — /health, /init
+// itself, port forwarding — stays reachable, or the gate could never be lifted
+// and readiness would deadlock against it.
+var rpcPathPrefixes = []string{
+	"/" + processconnect.ProcessName + "/",
+	"/" + filesystemconnect.FilesystemName + "/",
+}
+
+// gateUntilInitialized refuses the RPCs above until /init has been received.
+//
+// The orchestrator delivers a sandbox's environment variables, its injected
+// trust-store certificate and its egress credentials through /init, and it does
+// so after the daemon starts listening. A command accepted in that window runs
+// in a sandbox that is not yet the one the caller asked for: an empty
+// environment, an untrusted CA, an egress path that has not been armed. Failing
+// it with a precondition error is recoverable; running it and returning a wrong
+// answer is not.
+//
+// Connect maps a JSON error body with this code onto FAILED_PRECONDITION, which
+// the SDKs surface as a distinct error rather than a transport failure.
+func gateUntilInitialized(next http.Handler, service *api.API) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if service.Initialized() {
+			next.ServeHTTP(w, r)
+			return
+		}
+		gated := false
+		for _, prefix := range rpcPathPrefixes {
+			if strings.HasPrefix(r.URL.Path, prefix) {
+				gated = true
+				break
+			}
+		}
+		if !gated {
+			next.ServeHTTP(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusServiceUnavailable)
+		fmt.Fprint(w, `{"code":"failed_precondition","message":"sandbox is not initialized yet"}`)
+	})
+}

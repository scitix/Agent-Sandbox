+
+// Outside Firecracker there is nothing at 169.254.169.254 to answer, so the
+// MMDS poll can only run its deadline out: one request every 50ms for 60s,
+// 1200 per sandbox, every time. Under Kubernetes each is a connection the
+// pod's egress filter evaluates and logs, which is how this was found.
+func TestPostInit_MMDSPollGatedOnFirecracker(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		isNotFC   bool
+		wantPolls int32
+	}{
+		{"outside firecracker: no poll", true, 0},
+		{"inside firecracker: polls", false, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var polls atomic.Int32
+			done := make(chan struct{}, 1)
+			orig := pollMMDSOpts
+			pollMMDSOpts = func(context.Context, chan<- *host.MMDSOpts, *utils.EnvVars) {
+				polls.Add(1)
+				select {
+				case done <- struct{}{}:
+				default:
+				}
+			}
+			t.Cleanup(func() { pollMMDSOpts = orig })
+
+			api := newTestAPI(nil, &mockMMDSClient{})
+			api.isNotFC = tc.isNotFC
+
+			body, err := json.Marshal(PostInitJSONBody{})
+			require.NoError(t, err)
+			req, err := http.NewRequestWithContext(t.Context(), http.MethodPost, "/init", bytes.NewReader(body))
+			require.NoError(t, err)
+			rec := httptest.NewRecorder()
+			api.PostInit(rec, req)
+			require.Equal(t, http.StatusNoContent, rec.Code)
+
+			// The poll runs in a goroutine, so "it happened" needs a wait and
+			// "it did not" needs a bounded one — asserting immediately would
+			// pass for the wrong reason.
+			if tc.wantPolls > 0 {
+				select {
+				case <-done:
+				case <-time.After(2 * time.Second):
+					t.Fatal("expected the MMDS poll to start inside Firecracker")
+				}
+			} else {
+				select {
+				case <-done:
+					t.Fatal("the MMDS poll must not start outside Firecracker")
+				case <-time.After(250 * time.Millisecond):
+				}
+			}
+			assert.Equal(t, tc.wantPolls, polls.Load())
+		})
+	}
+}

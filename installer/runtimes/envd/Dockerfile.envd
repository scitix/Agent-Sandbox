FROM debian:bookworm-slim

ARG ENVD_VERSION=unknown

WORKDIR /workspace

# envd binary is expected to be copied into the build context as ./envd
COPY envd /workspace/envd
COPY agentbox-entrypoint.sh /workspace/agentbox-entrypoint.sh

RUN chmod +x /workspace/envd /workspace/agentbox-entrypoint.sh && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        sudo \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.source="https://github.com/scitix/agent-sandbox"
LABEL org.opencontainers.image.version="${ENVD_VERSION}"
LABEL org.opencontainers.image.description="envd runtime for agent-sandbox (e2b-dev/infra compatible)"

ENTRYPOINT ["/workspace/agentbox-entrypoint.sh"]
